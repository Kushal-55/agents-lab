# Copy this file to `.env` and fill in only what you need. `.env` is git-ignored.
# Never commit real keys.

# Which free LLM backend to use: ollama | openrouter | groq | gemini
#   ollama     -> runs locally, no key, fully private  (https://ollama.com)
#   openrouter -> free models end in ":free"            (https://openrouter.ai/keys)
#   groq       -> free tier                             (https://console.groq.com/keys)
#   gemini     -> free tier                             (https://aistudio.google.com/apikey)
LLM_PROVIDER=ollama

# Optional: override the provider's default model.
# LLM_MODEL=llama3.1:8b

# Only the key for the provider you chose is needed.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Optional tuning
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=0.2
# LOG_LEVEL=WARNING   # console level; the log file in data/runtime always records INFO
# AGENTLAB_DATA_DIR=./data/runtime
